# Django Settings
DJANGO_SECRET_KEY=your-secret-key-here
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_BASE_URL=https://your-ngrok-url.ngrok.io

# Database
DB_NAME=payments_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# Daraja API (M-Pesa)
DARAJA_ENVIRONMENT=sandbox
DARAJA_CONSUMER_KEY=your-consumer-key
DARAJA_CONSUMER_SECRET=your-consumer-secret
DARAJA_PASSKEY=your-passkey
MPESA_PAYBILL_SHORTCODE=your-paybill-shortcode
MPESA_INITIATOR_NAME=your-initiator-name
MPESA_SECURITY_CREDENTIAL=your-security-credential

# M-Pesa Global
MPESA_GLOBAL_ENABLED=True
MPESA_GLOBAL_MERCHANT_ID=your-merchant-id
MPESA_GLOBAL_API_KEY=your-api-key

# JWT
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN_SECONDS=3600

# Redis Cache
REDIS_URL=redis://localhost:6379/0

# Encryption
ENCRYPTION_KEY=your-encryption-key-here